#!/bin/sh
# A stub of shellops' dispatcher: install --check logs rsync missing and fails.
case "$*" in
  'install --check rsync')
    cat >&2 <<'TABLE'
Status     Tool                   Version        Channel
------------------------------------------------------------
  ✗      rsync                  3.2.7          system
TABLE
    exit 1
    ;;
  'install --check')
    cat >&2 <<'TABLE'
Status     Tool                   Version        Channel
------------------------------------------------------------
  ✓      ffmpeg                 6.1.1          system
  ✗      rsync                  3.2.7          system
TABLE
    exit 1
    ;;
  *) echo "ran $*" ;;
esac
