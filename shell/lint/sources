#!/bin/sh
# Prints the project's own source files that match the name patterns given, one
# per line, leaving out the shellops submodule, the lint fixtures and anything
# installed under node_modules:
#
#   shell/lint/sources '*.py'          ->  ./__init__.py ./workshop/ops.py ...
#   shell/lint/sources '*.js' '*.jsx'  ->  ./desktop/plugin.js ./desktop/src/pane.jsx ...
set -eu
set -f
cd "$(dirname "$0")/../.."

names=""
for pattern in "$@"; do
  names="$names -o -name $pattern"
done
names="${names# -o }"

# shellcheck disable=SC2086  # the -o -name list is built above on purpose; set -f keeps the patterns unexpanded
find . \
  \( -path ./.git -o -path ./shell/.ops -o -path ./tests/fixtures -o -name node_modules \) -prune \
  -o -type f \( $names \) -print \
  | sort
