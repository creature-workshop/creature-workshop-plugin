#!/bin/sh
# Prints the project's own source files that match the name patterns given, one
# per line. Every hidden directory is left out, which covers .git, the shellops
# submodule at shell/.ops and the tool cache under .ops/cache, and so are the
# lint fixtures, node_modules and __pycache__:
#
#   shell/lint/sources '*.py'          ->  ./__init__.py ./workshop/ops.py ...
#   shell/lint/sources '*.js' '*.jsx'  ->  ./dashboard/dist/index.js ...
set -eu
set -f
cd "$(dirname "$0")/../.."

names=""
for pattern in "$@"; do
  names="$names -o -name $pattern"
done
names="${names# -o }"

# shellcheck disable=SC2086  # the -o -name list is built above on purpose; set -f keeps the patterns unexpanded
find . \
  \( -name '.?*' -o -path ./tests/fixtures -o -name node_modules -o -name __pycache__ \) -prune \
  -o -type f \( $names \) -print \
  | sort
