#!/usr/bin/env bash
set -eu
# shellcheck disable=SC1091  # the project's own .envrc, which sets PROJ and SHELLOPS_DIR
. "$(dirname "$0")/../../../.envrc"

import \
  "$SHELLOPS_DIR/lib/git/api.sh" \
  "$SHELLOPS_DIR/lib/git/branches.sh" \
  "$PROJ/shell/lib/built/api.sh"

USAGE="$(cat <<'HELP'
Deploys a tree that shell/actions/hermes/build wrote, as one commit on top of
the current commit, on the built branch.

The Hermes catalog pins a plugin by the full hash of a commit, and Hermes
installs that commit, so the built tree has to be a commit on the forge. This
action records the directory as a commit whose parent is the source commit it
was built from, and moves the built branch to it under a lease on the tip it
had. It does not touch the checkout or the index.

The plugin/deploy job runs this after each merge on main, once plugin/catalog
has validated the same directory, pushing as the Blizz bot the way the release
tag goes. The built branch names no rung of shellops' ladder and the release
job never moves it; when promotion carries the build (OPS-1701), the job goes
away.

Usage: shell/actions/hermes/deploy [--from <dir>] [--branch <name>] [--no-push] [-h,--help]

  --from <dir>     the built tree; build/ at the project root when left out
  --branch <name>  the branch to deploy to; built when left out
  --no-push        make the commit and print it, without moving any branch
HELP
)"

ARG_FROM=""
ARG_BRANCH=built
ARG_PUSH=true

main() {
  parse_args "$@"
  __main__from="${ARG_FROM:-$PROJ/build}"
  require_built_tree "$__main__from"
  __main__source="$(git -C "$PROJ" rev-parse HEAD)"
  __main__tree="$(write_tree "$__main__from")"
  __main__built="$(commit_built "$__main__tree" "$__main__source")"
  printf 'built %s on top of %s\n' "$__main__built" "$__main__source"

  if [ "$ARG_PUSH" = true ]; then
    deploy "$__main__built"
  fi
}

parse_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h|--help) printf '%s\n' "$USAGE"; exit 0 ;;
      --from) ARG_FROM="$2"; shift ;;
      --branch) ARG_BRANCH="$2"; shift ;;
      --no-push) ARG_PUSH=false ;;
      *) printf 'deploy: unknown argument %s\n' "$1" >&2; exit 2 ;;
    esac
    shift
  done
}

: <<'FUN'
Exits, saying what to run, when the directory $1 does not hold a built tree.
FUN
require_built_tree() {
  if [ -f "$1/plugin.yaml" ]; then
    return 0
  fi
  printf 'deploy: %s holds no built tree; run shell/actions/hermes/build first\n' "$1" >&2
  exit 1
}

: <<'FUN'
Writes the directory $1 into the object store as a tree and prints the tree's
hash. A throwaway index keeps the checkout's own index untouched. The source's
.gitignore still applies inside the directory, so a cache that something wrote
there after the build stays out. The generated files match it, and a vendored
dependency carries a .gitignore of its own that leaves out its cache, so both
are added by force.
FUN
write_tree() {
  __write_tree__index="$(mktemp -u)"
  tree_git "$1" "$__write_tree__index" add -A -- "$1"
  for __write_tree__path in $(built__generated) $(built__vendored); do
    tree_git "$1" "$__write_tree__index" add -f -- "$1/$__write_tree__path"
  done
  tree_git "$1" "$__write_tree__index" write-tree
  rm -f "$__write_tree__index"
}

: <<'FUN'
Runs git with the directory $1 as the work tree and the file $2 as the index,
against this repository's object store, passing the rest of the arguments on.
FUN
tree_git() {
  __tree_git__dir="$1"
  __tree_git__index="$2"
  shift 2
  GIT_INDEX_FILE="$__tree_git__index" git \
    --git-dir="$(git -C "$PROJ" rev-parse --absolute-git-dir)" \
    --work-tree="$__tree_git__dir" \
    "$@"
}

: <<'FUN'
Records the tree $1 as a commit whose parent is the source commit $2, and
prints the commit's hash.
FUN
commit_built() {
  git -C "$PROJ" commit-tree "$1" -p "$2" \
    -m "build: the installed tree for $2" \
    -m "Written by shell/actions/hermes/build from the source at $2: the generated plugin.yaml, dashboard/manifest.json and desktop/plugin.js, without the tests and their fixtures. This commit is what the catalog pins."
}

: <<'FUN'
Moves the deploy branch to the build commit $1, under a lease on the tip the
remote held when this run read it. The branch is only ever a source commit
plus one build commit, so each deploy rewrites it; two deploys at once
cannot both win, since the second's lease is stale.
FUN
deploy() {
  __deploy__current="$(git__remote_branch_tip origin "$ARG_BRANCH")"
  git__force_move_branch origin "$ARG_BRANCH" "$__deploy__current" "$1"
  printf 'deployed %s to %s\n' "$1" "$ARG_BRANCH"
}

main "$@"
