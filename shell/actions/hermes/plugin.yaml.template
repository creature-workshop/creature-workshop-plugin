name: __NAME__
version: __VERSION__
manifest_version: 2
api_version: 1
description: "__DESCRIPTION__"
author: Jerrod
license: MIT
homepage: __HOMEPAGE__
tags: [devops, tools, desktop]
requires_hermes: ">=0.23.0"
python_dependencies:
  - "PyYAML>=6.0,<7"
provides_tools:
  - workshop_project
  - workshop_install
  - workshop_test
  - workshop_lint
provides_hooks:
  - pre_tool_call
config_schema:
  ops_timeout_seconds:
    type: int
    default: 120
    description: How long one shell/ops command may run before the tool reports a timeout.
  pane_refresh_seconds:
    type: int
    default: 20
    description: How often the Desktop pane re-runs install --check to refresh the toolchain.
