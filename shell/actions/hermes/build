#!/usr/bin/env bash
set -eu
# shellcheck disable=SC1091  # the project's own .envrc, which sets PROJ and SHELLOPS_DIR
. "$(dirname "$0")/../../../.envrc"

import "$SHELLOPS_DIR/lib/node/api.sh"

USAGE="$(cat <<HELP
Writes desktop/plugin.js, the file Hermes Desktop loads, from the JSX under
desktop/src/.

esbuild bundles desktop/src/plugin.jsx into one readable ES module, with the
JSX turned into React's runtime calls and the three modules Desktop provides
left as imports: @hermes/plugin-sdk, react and react/jsx-runtime. The output
is not tracked: the plugin/desktop job runs this to prove the source still
builds, and shell/actions/hermes/deploy commits what it wrote on the built
branch, which the catalog pins. esbuild comes from .ops/config/tools.yaml
through ops install, and runs from its package home, because its bin is a
native binary the npm channel's node shim cannot start.

With --watch, esbuild stays up and rewrites the output on every change under
desktop/src/; Desktop reloads a user plugin's file when it changes, so that
is the whole development loop.

Usage: shell/actions/hermes/build [--watch] [-h,--help]
HELP
)"

ARG_WATCH=""

main() {
  case "${1:-}" in
    -h|--help)
      printf '%s\n' "$USAGE"
      return 0
      ;;
    --watch)
      ARG_WATCH="--watch"
      ;;
  esac
  __main__esbuild="$(esbuild_binary)"
  require_esbuild "$__main__esbuild"
  # shellcheck disable=SC2086  # ARG_WATCH is one flag or nothing
  "$__main__esbuild" "$PROJ/desktop/src/plugin.jsx" $ARG_WATCH \
    --bundle \
    --format=esm \
    --platform=browser \
    --jsx=automatic \
    --jsx-import-source=react \
    --external:@hermes/plugin-sdk \
    --external:react \
    --external:react/jsx-runtime \
    --banner:js="$(banner)" \
    --outfile="$PROJ/desktop/plugin.js"
}

: <<'FUN'
Prints the path of the esbuild binary inside the package home ops install
keeps for it.
FUN
esbuild_binary() {
  printf '%s/esbuild/bin/esbuild\n' "$(node__package_modules esbuild)"
}

: <<'FUN'
Exits, saying what to run, when the esbuild binary $1 is not there.
FUN
require_esbuild() {
  if [ -x "$1" ]; then
    return 0
  fi
  printf 'build: esbuild is not installed at %s; run shell/ops install esbuild\n' "$1" >&2
  return 1
}

: <<'FUN'
Prints the JSDoc file block the output opens with, which says where it comes
from, since esbuild keeps none of the source's comments.
FUN
banner() {
  printf '/**\n * @file Creature Workshop in Hermes Desktop. Generated by shell/actions/hermes/build from desktop/src/; edit the source, not this file.\n */'
}

main "$@"
