#!/usr/bin/env bash
set -eu
# shellcheck disable=SC1091  # the project's own .envrc, which sets PROJ and SHELLOPS_DIR
. "$(dirname "$0")/../../../.envrc"

import \
  "$SHELLOPS_DIR/lib/git/api.sh" \
  "$PROJ/shell/lib/built/api.sh" \
  "$PROJ/shell/lib/vendor/api.sh"

USAGE="$(cat <<'HELP'
Builds the tree that Hermes installs, in a directory, from the current commit.

The tracked tree carries source only. This action runs the two generators,
shell/actions/hermes/manifests and shell/actions/hermes/bundle, writes the
current commit's tracked files into the output directory with git archive,
and copies the generated files in beside them. git archive leaves out every
path that .gitattributes marks export-ignore, which is the tests and their
fixtures, so consumers get only what runs. The commit is read from git, not
from the working tree, so the tree must be clean.

Hermes Agent installs no submodules, so the build writes a complete copy of
shellops at shell/.ops in place of the submodule: shellops at the commit the
submodule pins, with every tree it pins and its compiled tree, so that the
installed plugin boots shellops with no network. jq is the one thing the copy
cannot carry, since it is a binary; the user's machine provides it.

The plugin/build job runs this and keeps the directory as an artifact;
plugin/catalog runs hermes plugins validate on it, and
shell/actions/hermes/deploy commits it on the built branch.

Usage: shell/actions/hermes/build [--out <dir>] [-h,--help]

  --out <dir>  the directory to write; build/ at the project root when left
               out. It is emptied first.
HELP
)"

ARG_OUT=""

main() {
  parse_args "$@"
  __main__out="${ARG_OUT:-$PROJ/build}"
  restore_lock
  require_clean_tree
  generate
  archive_source "$__main__out"
  copy_generated "$__main__out"
  copy_vendored "$__main__out"
  printf 'built %s into %s\n' "$(git -C "$PROJ" rev-parse HEAD)" "$__main__out"
}

parse_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h|--help) printf '%s\n' "$USAGE"; exit 0 ;;
      --out) ARG_OUT="$2"; shift ;;
      *) printf 'build: unknown argument %s\n' "$1" >&2; exit 2 ;;
    esac
    shift
  done
}

: <<'FUN'
Puts .ops/lock back to the committed one. Every `ops install` run that is
not a check records what it resolved in the lock, and the CI base runs one
before this action, so the lock differs from the commit whenever a change
to tools.yaml landed without the lock that goes with it. The lock is the
release job's to commit, not the build's, so the build reads past it.
FUN
restore_lock() {
  git -C "$PROJ" checkout -q -- .ops/lock
}

: <<'FUN'
Exits when the tracked tree has uncommitted changes, since the source comes
from the commit and the generated files from the working tree, and the two
must agree. Names the changes, so a job log says which file was in the way.
FUN
require_clean_tree() {
  if [ "$(git__worktree_clean "$PROJ")" != true ]; then
    printf 'build: the tree has uncommitted or untracked changes; commit or discard them first:\n' >&2
    git -C "$PROJ" status --porcelain --ignore-submodules=all >&2
    exit 1
  fi
}

: <<'FUN'
Writes every generated file from the source tree.
FUN
generate() {
  "$PROJ/shell/actions/hermes/manifests"
  "$PROJ/shell/actions/hermes/bundle"
}

: <<'FUN'
Empties the directory $1 and writes the current commit's tracked files into
it, without the paths .gitattributes marks export-ignore.
FUN
archive_source() {
  rm -rf "$1"
  mkdir -p "$1"
  git -C "$PROJ" archive --format=tar HEAD | tar -x -C "$1"
}

: <<'FUN'
Copies each generated file into the directory $1, at the same path.
FUN
copy_generated() {
  for __copy_generated__file in $(built__generated); do
    cp "$PROJ/$__copy_generated__file" "$1/$__copy_generated__file"
  done
}

: <<'FUN'
Writes into the directory $1 a copy of each dependency the tracked tree has
as a submodule.
FUN
copy_vendored() {
  vendor__shellops "$1/shell/.ops"
}

main "$@"
