{"role":"module","name":"lib/system_packages/detect.sh","payload":[{"role":"path","payload":"lib/system_packages/detect.sh"},{"role":"reach","payload":"fragment"},{"role":"doc","payload":"Which distro this shell runs on and which package managers it can reach.\n__system_packages__detect_distro settles both on its first call and caches the\nanswer: it identifies the distro, then keeps the managers actually installed,\nthe ones that distro prefers first and any other supported manager after them.\nIt fails when the machine carries none of them.\n\nEvery other part of the installer reads the answer from here:\n__system_packages__AVAILABLE lists the managers in priority order,\n__system_packages__primary is the first of them, and __system_packages__DISTRO\nwith the OS version and codename describe the machine a repo is set up for."},{"role":"constant","name":"__system_packages__AVAILABLE","payload":[{"role":"line","payload":17},{"role":"doc","payload":"The managers found, in priority order, space-separated: POSIX sh has no arrays."},{"role":"contract","payload":[{"role":"visibility","payload":"private"}]}]},{"role":"constant","name":"__system_packages__DISTRO","payload":[{"role":"line","payload":20},{"role":"doc","payload":"The distribution id the machine reports, once detected."},{"role":"contract","payload":[{"role":"visibility","payload":"private"}]}]},{"role":"constant","name":"__system_packages__DETECTED","payload":[{"role":"line","payload":23},{"role":"doc","payload":"Whether detection has run, so it runs once per process."},{"role":"contract","payload":[{"role":"visibility","payload":"private"}]}]},{"role":"constant","name":"__system_packages__OS_VERSION","payload":[{"role":"line","payload":26},{"role":"doc","payload":"The OS version, once detected."},{"role":"contract","payload":[{"role":"visibility","payload":"private"}]}]},{"role":"constant","name":"__system_packages__OS_CODENAME","payload":[{"role":"line","payload":29},{"role":"doc","payload":"The OS codename, once detected."},{"role":"contract","payload":[{"role":"visibility","payload":"private"}]}]},{"role":"function","name":"__system_packages__primary","payload":[{"role":"line","payload":31},{"role":"contract","payload":[{"role":"visibility","payload":"private"}]}]},{"role":"function","name":"__system_packages__detect_distro","payload":[{"role":"line","payload":35},{"role":"contract","payload":[{"role":"visibility","payload":"private"}]}]},{"role":"function","name":"__system_packages__read_distro_id","payload":[{"role":"line","payload":62},{"role":"contract","payload":[{"role":"visibility","payload":"private"}]}]},{"role":"function","name":"__system_packages__read_os_release_fields","payload":[{"role":"line","payload":84},{"role":"contract","payload":[{"role":"visibility","payload":"private"}]}]},{"role":"function","name":"__system_packages__collect_available","payload":[{"role":"line","payload":91},{"role":"contract","payload":[{"role":"visibility","payload":"private"}]}]},{"role":"function","name":"__system_packages__collect_remaining","payload":[{"role":"line","payload":100},{"role":"contract","payload":[{"role":"visibility","payload":"private"}]}]}]}
