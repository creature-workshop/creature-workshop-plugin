#!/usr/bin/env bash
set -euo pipefail
. "$SHELLOPS_DIR/.envrc"

import "$SHELLOPS_DIR/lib/agents/api.sh"

USAGE="$(cat <<HELP
Cancels a run on an agent and prints the id the provider acknowledges.

Usage: action agents cancel <agent-id> <run-id> [--provider <id>] [-h,--help]

Flags:
  --provider <id>   The adaptor to reach; else the manifest's sole entry under
                    agents.providers, else SHELLOPS_AGENTS.
  -h, --help        Show this help text.

Environment:
  The selected provider's key variable (cursor: CURSOR_AGENT_API_KEY; cursor-cli:
  CURSOR_API_KEY; claude-cli: ANTHROPIC_API_KEY).
HELP
)"

ARG_PROVIDER=""
ARG_AGENT=""
ARG_RUN=""

main() {
  parse_args "$@"
  if ! @defined "$ARG_AGENT" || ! @defined "$ARG_RUN"; then
    error "an agent id and a run id are required"
    log "$USAGE"
    exit 1
  fi
  __main__options="$(agents__new_run_options "$ARG_PROVIDER")"
  __main__options="$(agents__with_key "$__main__options")" || exit 1
  agents__cancel "$__main__options" "$ARG_AGENT" "$ARG_RUN"
}

parse_args() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h|--help) log "$USAGE"; exit 0 ;;
      --provider) ARG_PROVIDER="$2"; shift ;;
      -*)
        error "Unknown option: $1"
        log "$USAGE"
        exit 1
        ;;
      *) take_positional "$1" ;;
    esac
    shift
  done
}

: <<'FUN'
Takes the positional $1 as the agent id, then the run id; a third is refused.
FUN
take_positional() {
  if ! @defined "$ARG_AGENT"; then
    ARG_AGENT="$1"
  elif ! @defined "$ARG_RUN"; then
    ARG_RUN="$1"
  else
    error "cancel takes an agent id and a run id, not '$1'"
    log "$USAGE"
    exit 1
  fi
}

# Run only when executed directly; sourcing (e.g. from bats) skips main.
case "$0" in
  */agents/cancel) main "$@" ;;
esac
