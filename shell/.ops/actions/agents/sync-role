#!/usr/bin/env bash
set -euo pipefail
. "$SHELLOPS_DIR/.envrc"

USAGE="$(cat <<'HELP'
The sync-hat action under the name the agents--sync-role creatures member
calls, so a consumer on that member gets the hat/* label from the shellops it
vendors.
HELP
)"

main() {
  case "${1:-}" in
    -h|--help)
      println "$USAGE"
      exit 0
      ;;
  esac

  exec "$(dirname "$0")/sync-hat" "$@"
}

main "$@"
