#!/usr/bin/env bash
set -eu

if [ -z "${SHELLOPS_DIR:-}" ]; then
  OWN_DIR="$(dirname "$0")"
  SHELLOPS_DIR="$(cd "$OWN_DIR/../.." && pwd)"
  export SHELLOPS_DIR
fi

# inline-comment-check: allow -- this runs before main, since shellops loads before any function is called, and it says why the unset sits here
# git clones a repository, and the submodules in one, with GIT_DIR and the
# variables beside it set for the clone it is making, and a helper it runs
# there inherits them. git obeys them over -C, so shellops would read that
# clone as it loads. They are dropped before it loads.
# shellcheck disable=SC2046  # one variable name per word, on purpose
unset $(git rev-parse --local-env-vars)
. "$SHELLOPS_DIR/.envrc"

import "$SHELLOPS_DIR/lib/git/credential.sh"

USAGE="$(cat <<'HELP'
Answers git's request for a credential with a token from the environment.

Usage: action git credential [-h,--help] <user> <token_env> <operation>

Arguments:
  <user>       The account the token signs in as, for example oauth2.
  <token_env>  The name of the environment variable that holds the token.
  <operation>  What git asks for: get, store or erase.

git runs this command as the credential helper named for a server, with its
request on stdin and the operation as the last argument. A get is answered
with username=<user> and password=<token>, so no token is written to disk.
When the variable is unset or empty, nothing is answered and git falls back
to its own prompt rules. store and erase are read and ignored.

lib/git/credential.sh names this command for a server, on one clone or
host-wide.
HELP
)"

main() {
  case "${1:-}" in
    -h|--help) show_help ;;
  esac
  require_three_arguments "$@"

  git__credential__answer "$1" "$2" "$3"
}

: <<'FUN'
Fails, printing the usage, unless git passed the account, the variable name
and the operation.
FUN
require_three_arguments() {
  if [ "$#" -eq 3 ]; then
    return 0
  fi

  error "git credential takes three arguments: <user> <token_env> <operation>"
  log "$USAGE"
  exit 2
}

show_help() {
  log "$USAGE"
  exit 0
}

main "$@"
