#!/usr/bin/env bash

SHELLOPS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SHELLOPS_DIR
export PROJ="${PROJ:-$SHELLOPS_DIR}"

source "$SHELLOPS_DIR/shell/.logs/shell/log/api.sh"
source "$SHELLOPS_DIR/lib/stdout/api.sh"
source "$SHELLOPS_DIR/lib/import.api.sh"
source "$SHELLOPS_DIR/lib/self/compiled.sh"
source "$SHELLOPS_DIR/lib/args/lines.sh"
source "$SHELLOPS_DIR/lib/git/trees/api.sh"
source "$SHELLOPS_DIR/lib/self/cache.sh"
source "$SHELLOPS_DIR/lib/self/pins.sh"
source "$SHELLOPS_DIR/lib/self/structs.sh"

# inline-comment-check: allow -- .envrc is sourced, neither a module nor an entrypoint, and this says why the call sits here
# The git trees the lock pins, fetched before the structs library loads and
# named by one exported variable each, STRATA_DIR among them (ADR 000049,
# ADR 000050). structs runs on the SILT library inside the strata tree
# shellops' own lock pins, whatever strata a host's lock pins beside it
# (ADR 000048), so SILT_DIR names that library.
self__pins__ensure
self__pins__own strata
if [ -n "$__self__pins__own__dir" ]; then  # structs-lint: allow -- plain shell, before structs loads
  SILT_DIR="$__self__pins__own__dir/shell/silt"
  export SILT_DIR
fi

# inline-comment-check: allow -- .envrc is sourced, neither a module nor an entrypoint, and this says why the call sits here
# The compiled trees, derived from each owner's sources before the structs
# library reads its scalars out of one (ADR 000047). After the pins, since
# the compile lowers a source through the scanner shell-scan's tree carries.
self__compiled__ensure

# inline-comment-check: allow -- .envrc is sourced, neither a module nor an entrypoint, and this says why the call sits here
# SILT's verbs, which the structs library runs on, made present before the
# library loads (ADR 000048).
self__structs__backend

source "$SHELLOPS_DIR/lib/structs/api.sh"
source "$SHELLOPS_DIR/lib/string/api.sh"

# file-label-check: allow -- .envrc is sourced, neither a module nor an entrypoint, and this documents the block below
: <<'DOC'
Activate the toolchain `ops install` provisioned: it records the channel bin
dirs (cargo, uv, go, zig...) and the homes those tools read to find themselves
(CARGO_HOME, RUSTUP_HOME...) as exports in .ops/cache/env.sh, sourced here so
every action and CI step sees the tools — no GITHUB_PATH, no per-action PATH
patching. An `if` (not `&&`) keeps this last line returning 0 when the file is
absent: cli/* tools source .envrc under `set -e`, and a non-zero tail aborts them.
DOC
if [ -f "$PROJ/.ops/cache/env.sh" ]; then
  source "$PROJ/.ops/cache/env.sh"
fi
